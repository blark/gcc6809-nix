+/** Returns the 16-bit half of the 32-bit operand X at byte offset OFF
+ * (0 = high, 2 = low).  A memory operand is addressed directly:
+ * simplify_gen_subreg would leave a (subreg:HI (mem:SI)) for a volatile
+ * memory reference, which no insn recognizes after expand.  The m6809 has
+ * no mode-dependent addresses except auto-increment, which movsi handles
+ * separately as push and pop. */
+rtx
+m6809_si_half (rtx x, int off)
+{
+	if (MEM_P (x))
+		return adjust_address (x, HImode, off);
+	return simplify_gen_subreg (HImode, x, SImode, off);
+}
