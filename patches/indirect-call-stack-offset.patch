 /* Set to 1 in subst_reg_equivs if it changes anything.  */
 static int subst_reg_equivs_changed;
 
+/* Set to 1 by find_reloads_address when, in a non-final pass, it leaves a
+   pseudo in place as an indirect address although the pseudo's equivalent
+   memory location must be re-eliminated (the stack pointer is not at its
+   initial offset).  find_reloads then reports a change so that the final
+   pass revisits the insn and makes that substitution; otherwise
+   replace_pseudos_in would substitute reg_equiv_mem, whose address holds
+   the initial elimination offset, and the insn would address the wrong
+   stack slot.  */
+static int equiv_mem_needs_replacement;
